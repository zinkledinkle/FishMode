Configs: {
	FishModeConfig: {
		DisplayName: Fish Mode Config

		BodyWidth: {
			Label: Body Width
			Tooltip: How wide the player's body is, in pixels
		}

		BaseSegmentLength: {
			Label: Base Segment Length
			Tooltip: How long each individual player segment is, in pixels.
		}

		DebugDraw: {
			Label: Debug Draw
			Tooltip: ""
		}

		MovementMode: {
			Label: Movement Mode
			Tooltip: Changes how the core movement works
		}

		Headers: {
			Experimental: Experimental
			CrossMod: Cross-Mod
		}

		DragonLensPixelateRadialHitboxes: {
			Label: DragonLens Pixelate Radial Hitboxes
			Tooltip: 
				'''
				Whether or not to apply a pixelation effect to radial hitboxes when visualized in DragonLens.
				it kinda looks like ass and I'm too lazy to come up with a better pixelation method
				'''
		}
	}

	MovementType: {
		Tooltip: ""

		LookAndLock: {
			Label: Look-And-Lock
			Tooltip: Uses {UpBind} to propel yourself where your mouse is pointing, and uses {LockBind} to lock onto enemies.
		}

		WASD: {
			Label: WASD
			Tooltip: Uses your main directional keys to move, uses your jump key to wave.
		}
	}
}

Krills: {
	Bioluminescence: {
		DisplayName: Bioluminescence
		Tooltip: Makes you emit light
	}

	Swordfish: {
		DisplayName: Swordfish
		Tooltip: Deals higher melee damage at faster speeds, up to 15%
	}

	Waves: {
		DisplayName: Waves
		Tooltip: Moving in a wave pattern makes you go faster
	}

	Slither: {
		DisplayName: Slither
		Tooltip: +1 Length (longer fish have higher speeds but bigger hitboxes)
	}

	Hydrodynamics: {
		DisplayName: Hydrodynamics
		Tooltip: Speeds up movement in viscous liquid by 40%
	}

	ArmoredScales: {
		DisplayName: Armored Scales
		Tooltip: +10% Damage Reduction
	}

	Blubber: {
		DisplayName: Blubber
		Tooltip: +25% Damage Reduction, -15% Movement Speed
	}

	BubbleBlower: {
		DisplayName: Bubble Blower
		Tooltip: Ranged strikes spawn small bubbles that deal 8 ranged damage (Limited to 12 bubbles per second)
	}

	BubbleBlaster: {
		DisplayName: Bubble Blaster
		Tooltip: Every 5th ranged projectile is encased in a damaging bubble that deals 20 ranged damage
	}

	BubbleBombardier: {
		DisplayName: Bubble Bombardier
		Tooltip:
			'''
			Ranged strikes have a 1 in 3 chance to spawn a damaging bubble that explodes on contact
			The bubble deals 25% of the original strikes damage + 15 ranged damage
			'''
	}

	Electrogenesis: {
		DisplayName: Electrogenesis
		Tooltip: Creates a large electric aura that damages enemies moving at higher speeds
		Combine_Jellyfish: Increases radius to 500 and deals 40 DPS on top of the electrified debuff
	}

	Jellyfish: {
		DisplayName: Jellyfish
		Tooltip: Creates a small electric aura that deals 20 DPS to enemies within it
	}

	MagicFangs: {
		DisplayName: Magic Fangs
		Tooltip: Magic attacks will regenerate mana
	}

	PistolShrimp: {
		DisplayName: Pistol Shrimp
		Tooltip: +60% Ranged projectile velocity
	}

	Quickfins: {
		DisplayName: Quickfins
		Tooltip: +20% movement speed
	}

	Radiance: {
		DisplayName: Radiance
		Tooltip: Makes you emit a very strong light
	}
}

